# =============================================================================
# Ada — environment variables
# Copy this file to .env and fill in your values.
# Lines beginning with # are comments and are ignored.
# =============================================================================


# =============================================================================
# Source database  (the PostgreSQL database being introspected)
# Read by DatabaseConfig.from_env(prefix="DB")
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public


# =============================================================================
# Repository database  (where the Knowledge Graph metadata is stored)
# Read by DatabaseConfig.from_env(prefix="REPO_DB")
# Can be the same database as the source, or a separate one.
# =============================================================================

REPO_DB_HOST=localhost
REPO_DB_PORT=5432
REPO_DB_NAME=
REPO_DB_USER=
REPO_DB_PASSWORD=
REPO_DB_SCHEMA=public


# =============================================================================
# Chroma vector store  (persistent embedding index)
# =============================================================================

# Directory where Chroma persists its data on disk.
CHROMA_PERSIST_DIR=./chroma_db


# =============================================================================
# OpenAI
# Required for description generation (gpt-4o-mini) and embedding generation
# (text-embedding-3-small).  Can be omitted if you run with both
# --skip-descriptions and --skip-embeddings.
# =============================================================================

OPENAI_API_KEY=

# Model overrides (optional — defaults shown)
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2


# =============================================================================
# Langfuse  (optional — LLM observability)
# When these keys are set all OpenAI calls are automatically traced via the
# Langfuse OpenAI wrapper.  Leave blank to disable tracing.
# =============================================================================

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
